<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial1.controller.ReportesViewController">
    <children>
        <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#onVolverMenu" text="&lt;- Volver" />

        <Label layoutX="240.0" layoutY="16.0" style="-fx-font-weight: bold;" text="Reportes e Ingresos del Gimnasio">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <!-- Panel de Filtro por Rango de Fechas -->
        <Pane layoutX="30.0" layoutY="60.0" prefHeight="80.0" prefWidth="700.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f9f9f9;">
            <children>
                <Label layoutX="15.0" layoutY="10.0" style="-fx-font-weight: bold;" text="Filtro de Consulta por Fechas" />

                <Label layoutX="15.0" layoutY="42.0" text="Fecha Inicio:" />
                <DatePicker fx:id="dpFechaInicio" layoutX="95.0" layoutY="38.0" prefWidth="150.0" />

                <Label layoutX="265.0" layoutY="42.0" text="Fecha Fin:" />
                <DatePicker fx:id="dpFechaFin" layoutX="335.0" layoutY="38.0" prefWidth="150.0" />

                <Button layoutX="510.0" layoutY="37.0" mnemonicParsing="false" onAction="#onConsultarIngresos" prefHeight="28.0" prefWidth="160.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold;" text="Consultar Ingresos" />
            </children>
        </Pane>

        <!-- Tarjetas de Resumen Financiero -->
        <Pane layoutX="30.0" layoutY="155.0" prefHeight="90.0" prefWidth="215.0" style="-fx-background-color: #e3f2fd; -fx-background-radius: 8; -fx-border-color: #90caf9; -fx-border-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="12.0" text="Ingresos por Planes" textFill="#1565c0">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <Label fx:id="lblIngresosPlanes" layoutX="15.0" layoutY="40.0" text="\$ 0.0" textFill="#0d47a1">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <Pane layoutX="272.0" layoutY="155.0" prefHeight="90.0" prefWidth="215.0" style="-fx-background-color: #f3e5f5; -fx-background-radius: 8; -fx-border-color: #ce93d8; -fx-border-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="12.0" text="Servicios Adicionales" textFill="#7b1fa2">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <Label fx:id="lblIngresosServicios" layoutX="15.0" layoutY="40.0" text="\$ 0.0" textFill="#4a148c">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <Pane layoutX="515.0" layoutY="155.0" prefHeight="90.0" prefWidth="215.0" style="-fx-background-color: #e8f5e9; -fx-background-radius: 8; -fx-border-color: #a5d6a7; -fx-border-radius: 8;">
            <children>
                <Label layoutX="15.0" layoutY="12.0" text="Total Acumulado" textFill="#2e7d32">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <Label fx:id="lblTotalAcumulado" layoutX="15.0" layoutY="40.0" text="\$ 0.0" textFill="#1b5e20">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <!-- Tabla de Detalle de Inscripciones en el Rango -->
        <Label layoutX="30.0" layoutY="265.0" style="-fx-font-weight: bold;" text="Detalle de Inscripciones y Transacciones en el Período" />

        <TableView fx:id="tblReportes" layoutX="30.0" layoutY="290.0" prefHeight="230.0" prefWidth="700.0">
            <columns>
                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                <TableColumn fx:id="colCliente" prefWidth="180.0" text="Cliente" />
                <TableColumn fx:id="colPlan" prefWidth="180.0" text="Plan Adquirido" />
                <TableColumn fx:id="colCantServicios" prefWidth="110.0" text="Servicios Adic." />
                <TableColumn fx:id="colTotalInscripcion" prefWidth="130.0" text="Valor Total ($)" />
            </columns>
        </TableView>
    </children>
</AnchorPane>