<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial1.controller.EntrenadorViewController">
    <children>
        <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#onVolverMenu" text="&lt;- Volver" />
        <Label layoutX="295.0" layoutY="25.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Gestión de Entrenadores" />

        <!-- Formulario Izquierda -->
        <Label layoutX="40.0" layoutY="80.0" text="Cédula" />
        <TextField fx:id="txtIdentificacion" layoutX="40.0" layoutY="102.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="140.0" text="Nombre " />
        <TextField fx:id="txtNombre" layoutX="40.0" layoutY="162.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="200.0" text="Especialidad" />
        <TextField fx:id="txtEspecialidad" layoutX="40.0" layoutY="222.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="260.0" text="Teléfono" />
        <TextField fx:id="txtTelefono" layoutX="40.0" layoutY="282.0" prefWidth="180.0" />

        <Label layoutX="40.0" layoutY="320.0" text="Tarifa por Sesión" />
        <TextField fx:id="txtTarifa" layoutX="40.0" layoutY="342.0" prefWidth="180.0" />

        <Button layoutX="75.0" layoutY="390.0" mnemonicParsing="false" onAction="#onGuardarEntrenador" text="Guardar Entrenador" />

        <!-- Tabla Derecha -->
        <TableView fx:id="tblEntrenadores" layoutX="250.0" layoutY="80.0" prefHeight="330.0" prefWidth="470.0">
            <columns>
                <TableColumn fx:id="colIdentificacion" prefWidth="90.0" text="Cédula" />
                <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                <TableColumn fx:id="colEspecialidad" prefWidth="100.0" text="Especialidad" />
                <TableColumn fx:id="colTelefono" prefWidth="80.0" text="Teléfono" />
                <TableColumn fx:id="colTarifa" prefWidth="80.0" text="Tarifa " />
            </columns>
        </TableView>
    </children>
</AnchorPane>
